  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primario",
      "description": "La única acción rellena del bloque (Registrar movimiento, Guardar, Ingresar).",
      "html": "<button class=\"ds-btn ds-btn-primario\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Registrar movimiento</button>",
      "css": ".ds-icon{width:1rem;height:1rem;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn{display:inline-flex;align-items:center;gap:.45rem;border:1px solid #c3cddd;background:#fff;color:#13284b;padding:.52rem .95rem;border-radius:8px;font:inherit;font-size:.9rem;font-weight:600;min-height:2.4rem;cursor:pointer;transition:background-color .15s,border-color .15s,box-shadow .15s,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{box-shadow:0 0 0 3px rgba(201,161,59,.45);outline:none}.ds-btn-primario{background:#1f6fd1;border-color:#1f6fd1;color:#fff;box-shadow:0 1px 2px rgba(31,111,209,.3),0 4px 10px -4px rgba(31,111,209,.5)}.ds-btn-primario:hover{background:#1758a8;border-color:#1758a8}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secundario",
      "description": "Acciones de apoyo: Ver todas, Imprimir, Descargar PDF, Salir.",
      "html": "<button class=\"ds-btn\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><path d=\"m7 10 5 5 5-5\"/><path d=\"M12 15V3\"/></svg>Descargar PDF</button>",
      "css": ".ds-icon{width:1rem;height:1rem;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn{display:inline-flex;align-items:center;gap:.45rem;border:1px solid #c3cddd;background:#fff;color:#13284b;padding:.52rem .95rem;border-radius:8px;font:inherit;font-size:.9rem;font-weight:600;min-height:2.4rem;cursor:pointer;transition:background-color .15s,border-color .15s,box-shadow .15s,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{box-shadow:0 0 0 3px rgba(201,161,59,.45);outline:none}.ds-btn:hover{background:#f1f4fa;border-color:#24467d}"
    },
    {
      "name": "Botón de peligro",
      "kind": "button",
      "refersTo": "button-peligro",
      "description": "Sólo para anular una operación con motivo.",
      "html": "<button class=\"ds-btn ds-btn-peligro\">Anular operación</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:.45rem;border:1px solid #c3cddd;background:#fff;color:#13284b;padding:.52rem .95rem;border-radius:8px;font:inherit;font-size:.9rem;font-weight:600;min-height:2.4rem;cursor:pointer;transition:background-color .15s,border-color .15s,box-shadow .15s,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{box-shadow:0 0 0 3px rgba(201,161,59,.45);outline:none}.ds-btn-peligro{background:#b42318;border-color:#b42318;color:#fff}.ds-btn-peligro:hover{background:#95190f;border-color:#95190f}"
    },
    {
      "name": "Campo de formulario",
      "kind": "input",
      "refersTo": "input",
      "description": "Etiqueta encima, campo con foco azul y ayuda atenuada.",
      "html": "<div class=\"ds-campo\"><label for=\"ds-m\">Monto <span class=\"ds-req\">*</span></label><input id=\"ds-m\" class=\"ds-input\" placeholder=\"0.00\"><span class=\"ds-ayuda\">En lempiras.</span></div>",
      "css": ".ds-campo{display:flex;flex-direction:column;gap:.35rem;max-width:280px}.ds-campo label{font-size:.85rem;font-weight:600;color:#1b3561}.ds-req{color:#b45f05}.ds-ayuda{font-size:.79rem;color:#6b778d}.ds-input{font:inherit;font-size:.93rem;padding:.52rem .7rem;border:1px solid #c3cddd;border-radius:8px;background:#fff;color:#15233d;min-height:2.5rem;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:#75819a}.ds-input:hover{border-color:#24467d}.ds-input:focus{outline:none;border-color:#1f6fd1;box-shadow:0 0 0 3px rgba(31,111,209,.18)}"
    },
    {
      "name": "Riel lateral",
      "kind": "nav",
      "refersTo": "nav-item-activo",
      "description": "Riel marino con filete dorado, sello sobre disco blanco con aro dorado, ítem activo con icono dorado.",
      "html": "<nav class=\"ds-riel\"><div class=\"ds-marca\"><span class=\"ds-sello\"></span><strong>CAUNE</strong></div><div class=\"ds-grupo\">Operación</div><a href=\"#\" class=\"ds-item ds-activo\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg>Afiliados</a><a href=\"#\" class=\"ds-item\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 3 4 7l4 4\"/><path d=\"M4 7h16\"/><path d=\"m16 21 4-4-4-4\"/><path d=\"M20 17H4\"/></svg>Aportaciones y depósitos</a></nav>",
      "css": ".ds-icon{width:1.15rem;height:1.15rem;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-riel{width:264px;background:#13284b;border-right:1px solid #c9a13b;padding:1rem .7rem;display:flex;flex-direction:column;gap:2px}.ds-marca{display:flex;align-items:center;gap:.85rem;padding:.35rem .55rem 1rem}.ds-sello{width:48px;height:48px;border-radius:50%;background:#fff;box-shadow:0 0 0 2px #c9a13b}.ds-marca strong{color:#fff;font-size:1.3rem;letter-spacing:.14em;font-weight:800}.ds-grupo{font-size:.7rem;font-weight:650;text-transform:uppercase;letter-spacing:.1em;color:#8597b8;padding:1rem .75rem .35rem}.ds-item{display:flex;align-items:center;gap:.7rem;padding:.58rem .75rem;border-radius:10px;color:#d3dcee;text-decoration:none;font-size:.93rem;font-weight:500;transition:background-color .18s cubic-bezier(.16,1,.3,1),color .18s}.ds-item .ds-icon{color:#8fa3c7}.ds-item:hover{background:rgba(255,255,255,.06);color:#fff}.ds-item:hover .ds-icon{color:#fff}.ds-activo{background:#24467d;color:#fff;box-shadow:inset 0 0 0 1px rgba(233,211,152,.25)}.ds-activo .ds-icon{color:#e9d398}.ds-item:focus-visible{box-shadow:0 0 0 3px rgba(201,161,59,.45);outline:none}"
    },
    {
      "name": "Badges de estado",
      "kind": "chip",
      "refersTo": "badge-ok",
      "description": "Confirmado lleva anillo y punto dorados (el sello de la fila); anulado en rojo; aviso en naranja.",
      "html": "<span class=\"ds-badge ds-ok\">Confirmado</span> <span class=\"ds-badge ds-mal\">Anulado</span> <span class=\"ds-badge ds-aviso\">Pendiente</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:650;padding:.16rem .58rem;border-radius:999px}.ds-ok{background:#f1f4fa;color:#1b3561;box-shadow:inset 0 0 0 1px #c9a13b}.ds-ok::before{content:\"\";width:.42rem;height:.42rem;border-radius:50%;background:#c9a13b}.ds-mal{background:#fdecea;color:#b42318}.ds-aviso{background:#fdf1e3;color:#b45f05}"
    },
    {
      "name": "KPI con banda de clase",
      "kind": "card",
      "refersTo": "kpi",
      "description": "Saldo clave: banda naranja para aportaciones, azul para depósitos; el destacado invierte a marino.",
      "html": "<div class=\"ds-kpis\"><div class=\"ds-kpi ds-destacado ds-aport\"><div class=\"ds-etq\">Aportaciones acumuladas</div><div class=\"ds-valor\">L 184,250.00</div><div class=\"ds-det\">Al cierre del mes anterior: L 176,000.00</div></div><div class=\"ds-kpi ds-dep\"><div class=\"ds-etq\">Depósitos reembolsables</div><div class=\"ds-valor\">L 42,800.00</div><div class=\"ds-det\">Al cierre del mes anterior: L 40,100.00</div></div></div>",
      "css": ".ds-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem}.ds-kpi{background:#fff;border:1px solid #dbe2ec;border-radius:12px;padding:1.05rem 1.15rem 1rem;box-shadow:0 1px 2px rgba(19,40,75,.05),0 4px 14px -6px rgba(19,40,75,.12)}.ds-etq{font-size:.82rem;color:#45526b;font-weight:550}.ds-valor{font-size:1.55rem;font-weight:700;margin-top:.35rem;font-variant-numeric:tabular-nums;color:#13284b;letter-spacing:-.015em}.ds-det{font-size:.8rem;color:#6b778d;margin-top:.2rem;font-variant-numeric:tabular-nums}.ds-dep{box-shadow:inset 0 3px 0 #1f6fd1,0 1px 2px rgba(19,40,75,.05),0 4px 14px -6px rgba(19,40,75,.12)}.ds-destacado{background:#13284b;border-color:#13284b}.ds-destacado .ds-valor{color:#fff}.ds-destacado .ds-etq,.ds-destacado .ds-det{color:#b9c6de}.ds-destacado.ds-aport{box-shadow:inset 0 3px 0 #e8800f,0 2px 4px rgba(19,40,75,.06),0 12px 32px -12px rgba(19,40,75,.28)}"
    },
    {
      "name": "Tabla de operaciones",
      "kind": "custom",
