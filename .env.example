# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# Genere una clave con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=caune.ejemplo.hn
DJANGO_CSRF_TRUSTED_ORIGINS=https://caune.ejemplo.hn

# PostgreSQL (en docker-compose el host es "db")
POSTGRES_DB=caune
POSTGRES_USER=caune
POSTGRES_PASSWORD=
DATABASE_URL=postgres://caune:CAMBIAR@db:5432/caune

# Solo si la app está detrás de un proxy inverso propio (nginx, Caddy, Traefik)
CAUNE_CONFIAR_PROXY=true

# Respaldos: cuántos días conservar
RESPALDO_DIAS_RETENCION=30
